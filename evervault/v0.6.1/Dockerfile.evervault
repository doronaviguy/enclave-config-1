# Co-signer audit image for Evervault Enclaves (AWS Nitro).
#
# `ev enclave build --reproducible` turns this into an Enclave Image File whose
# PCR0/1/2 measure the whole image, including every ENV below. So the measured
# settings (release tag, sealed-settings commitment, platform, key mode, price
# source) are baked in as build args: one tag = one image = one set of PCRs.
#
# deploy-evervault.sh builds from a context it stages with `git archive` at a
# clean commit (shared/, backend/ and the scorer only), so anyone can rebuild
# the same tree with the same build args and compare PCRs. Every file in that
# context carries the commit time, and the binary is stamped with it too.
#
# Secrets (AUDIT_SECRET_CONFIG, AUDIT_SECRET_TELEGRAM_BOT_TOKEN) are Evervault
# encrypted environment variables, injected at boot and not measured; the
# binary refuses AUDIT_SECRET_CONFIG unless it matches the measured commitment.

# No ENV anywhere in this file: `ev enclave build` removes every ENV line, from
# every stage, and replays them as exports in the enclave's start script. Build
# settings are therefore given inline, and the measured settings below become
# exports in the start script (which is part of the measured image).

# golang:1.25.6-bookworm on the build host's platform, cross-compiling a static
# linux/amd64 binary: Nitro enclaves are x86-64.
FROM --platform=$BUILDPLATFORM golang@sha256:f4490d7b261d73af4543c46ac6597d7d101b6e1755bcdd8c5159fda7046b6b3e AS build
ARG SOURCE_DATE_EPOCH=0
WORKDIR /src
COPY shared/go.mod shared/go.sum ./shared/
COPY backend/go.mod backend/go.sum ./backend/
RUN cd backend && GOWORK=off GOFLAGS=-mod=readonly go mod download
COPY shared/ ./shared/
COPY backend/ ./backend/
RUN cd backend && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOWORK=off GOFLAGS=-mod=readonly go build -trimpath -buildvcs=false -ldflags="-s -w -buildid=" -o /out/cosigner-audit ./cmd/cosigner-audit && touch -d "@${SOURCE_DATE_EPOCH}" /out/cosigner-audit

# python:3.12.11-slim-bookworm (the deterministic scorer is standard-library
# only), pinned to amd64: the digest is a multi-platform index, and ev builds
# for the host's platform, which on an Apple Silicon Mac is arm64.
FROM --platform=linux/amd64 python@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7
ARG AUDIT_RELEASE_TAG
ARG AUDIT_CONFIG_COMMITMENT
ARG AUDIT_PRICE_SOURCE=binance-spot
ARG AUDIT_MODES=light
COPY --from=build /out/cosigner-audit /app/cosigner-audit
COPY skills/analyze-perpetual-user-health/scripts/calculate_health_score.py /app/skills/analyze-perpetual-user-health/scripts/calculate_health_score.py
# One ENV per line: the Evervault CLI's Dockerfile parser rejects an ENV
# continued over several lines ("Incomplete instruction found"). These are
# the only ENV lines in the file (see the top).
ENV AUDIT_RELEASE_TAG=${AUDIT_RELEASE_TAG}
ENV AUDIT_CONFIG_COMMITMENT=${AUDIT_CONFIG_COMMITMENT}
ENV AUDIT_PLATFORM=evervault
ENV AUDIT_KEY_MODE=nitro
ENV AUDIT_PRICE_SOURCE=${AUDIT_PRICE_SOURCE}
ENV AUDIT_MODES=${AUDIT_MODES}
ENV AUDIT_LISTEN_ADDR=0.0.0.0:8090
ENV AUDIT_REPO_PATH=/app
WORKDIR /app
# Evervault's data plane terminates TLS and forwards requests here. It runs
# alongside the service inside the enclave, so the image keeps the default
# user rather than the nilCC/Tinfoil image's 65532.
EXPOSE 8090
ENTRYPOINT ["/app/cosigner-audit"]
